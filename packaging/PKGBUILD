# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oopath-bin
_pkgname=oopath
pkgver=0.1.0
pkgrel=1
pkgdesc="Sovereign path syntax sanitizer normalizing relative components and dot segments."
arch=('x86_64')
url="https://github.com/openOODA-tools/oopath"
license=('Apache-2.0')
depends=('glibc')
provides=('oopath')
conflicts=('oopath')
source_x86_64=("${url}/releases/download/v${pkgver}/oopath-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oopath-linux-x86_64" "${pkgdir}/usr/bin/oopath"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oopath-uninstall"
}
